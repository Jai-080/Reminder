<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Main app theme - follows system light/dark automatically -->
    <style name="Theme.Reminder" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/light_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:timePickerMode">spinner</item>

        <!-- Light theme surface colors -->
        <item name="android:windowBackground">@color/light_background</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_text_primary</item>
    </style>

    <!-- TimePicker styles -->
    <style name="TimePickerTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:timePickerMode">spinner</item>
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorAccent">@color/accent_purple</item>
        <item name="buttonBarPositiveButtonStyle">@style/TimePickerButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/TimePickerButtonStyle</item>
    </style>

    <style name="TimePickerButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_purple</item>
    </style>

</resources>
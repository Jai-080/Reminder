<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/windowBackground"
        app:elevation="0dp">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/ic_ms_arrow_back"
                app:iconTint="?android:attr/textColorPrimary"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Timed Reminders"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <View
            android:id="@+id/headerDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorDivider" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="96dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- New Reminder Creation Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Reminder.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SCHEDULE REMINDER"
                        android:textColor="@color/gl_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/editTextReminder"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_edittext"
                            android:hint="Reminder message..."
                            android:textColor="?android:attr/textColorPrimary"
                            android:textColorHint="@color/colorHint"
                            android:textSize="14sp"
                            android:paddingHorizontal="14dp"
                            android:inputType="textCapSentences"
                            android:maxLines="1"
                            android:autofillHints="none" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetReminderFull"
                            style="@style/Widget.Reminder.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:text="Set"
                            app:icon="@drawable/ic_ms_calendar"
                            app:iconTint="@color/white"
                            android:paddingHorizontal="16dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Single Unified Friendly Empty State -->
            <LinearLayout
                android:id="@+id/emptyRemindersLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="36dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_ms_notifications"
                    android:alpha="0.35"
                    app:tint="?android:attr/textColorSecondary"
                    android:contentDescription="No reminders scheduled"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Schedule a reminder using the form above."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Pending Section Header -->
            <TextView
                android:id="@+id/pendingLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PENDING REMINDERS"
                android:textColor="@color/gl_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtNoPendingReminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No pending reminders"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                android:paddingVertical="12dp"
                android:layout_marginStart="4dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_pending_reminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:nestedScrollingEnabled="false" />

            <!-- Expired Section Header -->
            <TextView
                android:id="@+id/expiredLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EXPIRED REMINDERS"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtNoExpiredReminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No expired reminders"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                android:paddingVertical="12dp"
                android:layout_marginStart="4dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_expired_reminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Clear All Button Pinned to Bottom -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/clearAllBtn"
        style="@style/Widget.Reminder.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:text="@string/clear_all"
        android:textColor="@color/colorDelete"
        app:icon="@drawable/ic_ms_delete"
        app:iconTint="@color/colorDelete" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

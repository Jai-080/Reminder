<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/snooze_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F0F"
    android:paddingHorizontal="20dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Snooze reminder"
        android:textColor="#F0F0F0"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_snooze_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Snooze for how long?"
        android:textColor="#666666"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="32dp" />

    <!-- 1 min snooze -->
    <LinearLayout
        android:id="@+id/btn_snooze_1_min"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/rounded_item_background"
        android:paddingHorizontal="18dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 minute"
                android:textColor="#CCCCCC"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#7F77DD"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- 5 min snooze -->
    <LinearLayout
        android:id="@+id/btn_snooze_5_min"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/rounded_item_background"
        android:paddingHorizontal="18dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 minutes"
                android:textColor="#CCCCCC"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#7F77DD"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- 10 min snooze -->
    <LinearLayout
        android:id="@+id/btn_snooze_10_min"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/rounded_item_background"
        android:paddingHorizontal="18dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 minutes"
                android:textColor="#CCCCCC"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#7F77DD"
            android:textSize="22sp" />
    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment Name"
            android:textSize="14sp"
            android:textColor="@color/colorTextPrimary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dialogPaymentNameLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="@color/accent_purple">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dialogPaymentNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Netflix"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amount (Optional)"
            android:textSize="14sp"
            android:textColor="@color/colorTextPrimary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dialogPaymentAmountLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="@color/accent_purple">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dialogPaymentAmountInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. 649"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Due Date"
            android:textSize="14sp"
            android:textColor="@color/colorTextPrimary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogDateButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Select Date"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"
            app:strokeColor="@color/accent_purple"
            app:cornerRadius="12dp"
            android:textColor="@color/colorTextPrimary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recurrence"
            android:textSize="14sp"
            android:textColor="@color/colorTextPrimary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/dialogRecurrenceSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/rounded_edittext"
            android:spinnerMode="dropdown" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notifications"
            android:textSize="14sp"
            android:textColor="@color/colorTextPrimary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkboxNotify7d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7 days before"
                android:checked="true"
                android:textSize="14sp"
                app:buttonIconTint="@color/white" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkboxNotify3d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 days before"
                android:checked="true"
                android:textSize="14sp"
                app:buttonIconTint="@color/white" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkboxNotify1d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 day before"
                android:checked="true"
                android:textSize="14sp"
                app:buttonIconTint="@color/white" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkboxNotifyDue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Due date"
                android:checked="true"
                android:textSize="14sp"
                app:buttonIconTint="@color/white" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

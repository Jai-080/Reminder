<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_item_background"
    android:padding="16dp"
    android:layout_margin="8dp">

    <!-- Reminder Text -->
    <TextView
        android:id="@+id/reminderText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/expiredIcon"
        android:text="Reminder Text"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Expired Icon -->

    <!-- Delete Button -->

    <ImageView
        android:id="@+id/expiredIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:layout_toStartOf="@+id/deleteButton"
        android:contentDescription="Expired"
        android:src="@drawable/ic_notification_off"
        android:visibility="visible"
        app:tint="#FF0000" />

    <ImageView
        android:id="@+id/deleteButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp"
        android:contentDescription="Delete Reminder"
        android:src="@android:drawable/ic_menu_delete"
        android:scaleType="centerInside"
        app:tint="@android:color/holo_red_dark" />

    <!-- Reminder Time (below text) -->
    <TextView
        android:id="@+id/reminderTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="4 Jul 2025 21:56:00"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:layout_below="@id/reminderText"
        android:layout_alignStart="@id/reminderText"
        android:layout_marginTop="4dp" />

</RelativeLayout>

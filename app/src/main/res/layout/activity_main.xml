<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/windowBackground"
        app:liftOnScroll="false"
        app:liftOnScrollColor="@android:color/transparent"
        app:statusBarForeground="@null"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reminder"
                    android:textColor="@color/gl_primary"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02" />

                <TextView
                    android:id="@+id/txtLastSync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last Synced: Loading..."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- Sync Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSync"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:icon="@drawable/ic_ms_sync"
                app:iconTint="?android:attr/textColorPrimary"
                android:contentDescription="Sync with server" />

            <!-- Custom Animated Light/Dark Theme Toggle (Exact Design) -->
            <com.example.reminder.ui.ThemeToggleView
                android:id="@+id/dashboardThemeToggle"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />

            <!-- Settings Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:icon="@drawable/ic_ms_settings"
                app:iconTint="?android:attr/textColorPrimary"
                android:contentDescription="Settings" />

            <!-- Hidden Logout View to preserve reference if needed -->
            <View
                android:id="@+id/btnLogout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorDivider" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Main Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Welcome Greeting Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Reminder.CardView"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/colorSurfaceVariant"
                app:strokeColor="@color/colorDivider"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtWelcomeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Welcome back!"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Here is your overview for today"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_ms_check_circle"
                        app:tint="@color/gl_primary"
                        android:contentDescription="Status icon" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Metric Cards Row: Notes & Timed Reminders -->
            <LinearLayout
                android:id="@+id/summaryCardsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Card 1: Notes Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quickNotesSummaryCard"
                    style="@style/Widget.Reminder.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="NOTES"
                                android:textColor="@color/gl_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_ms_notes"
                                app:tint="@color/gl_primary"
                                android:contentDescription="Notes icon" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtNotesCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/txtNotesSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 active"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Reminders Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/timedRemindersBtn"
                    style="@style/Widget.Reminder.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="REMINDERS"
                                android:textColor="@color/gl_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_ms_notifications"
                                app:tint="@color/gl_primary"
                                android:contentDescription="Reminders icon" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtRemindersCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/txtRemindersSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 pending"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Card 3: Payments Card (Full Width) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/monthlyPaymentsBtn"
                style="@style/Widget.Reminder.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:baselineAligned="false">

                    <!-- Left Column: Summary Stats -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="PAYMENTS"
                                android:textColor="@color/gl_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_ms_payments"
                                app:tint="@color/gl_primary"
                                android:contentDescription="Payments icon" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtPaymentsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/txtPaymentsSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 overdue | 0 due"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="12dp"
                        android:background="@color/colorDivider" />

                    <!-- Right Column: Next Due Details -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NEXT UPCOMING"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/txtNextPaymentDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No upcoming bills"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="2" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Notes Checklist Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/notesSectionCard"
                style="@style/Widget.Reminder.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="QUICK NOTES CHECKLIST"
                            android:textColor="@color/gl_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06" />

                        <TextView
                            android:id="@+id/btnClearAllNotes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="@string/clear_all"
                            android:textColor="@color/gl_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackground" />
                    </RelativeLayout>

                    <!-- Add Note Input Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <EditText
                            android:id="@+id/editTextQuickNote"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_edittext"
                            android:hint="@string/add_note_hint"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textColorHint="@color/colorHint"
                            android:textSize="14sp"
                            android:paddingHorizontal="14dp"
                            android:inputType="text"
                            android:maxLines="1"
                            android:autofillHints="none" />

                        <ImageView
                            android:id="@+id/btnAddQuickNote"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/rounded_primary_button"
                            android:padding="12dp"
                            android:src="@drawable/ic_ms_add"
                            android:contentDescription="@string/add_note_desc"
                            app:tint="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerQuickNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Upcoming Agenda Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/agendaSectionCard"
                style="@style/Widget.Reminder.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UPCOMING AGENDA"
                        android:textColor="@color/gl_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="14dp" />

                    <!-- Reminders Preview Sub-card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/sectionUpcomingReminders"
                        style="?attr/materialCardViewFilledStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="14dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/colorDivider"
                        app:cardBackgroundColor="@color/colorSurfaceVariant">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="6dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Timed Reminders"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_ms_calendar"
                                    app:tint="@color/gl_primary"
                                    android:contentDescription="Calendar icon" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtNoUpcomingReminders"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="No upcoming reminders"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="13sp"
                                android:visibility="gone"
                                android:paddingVertical="4dp" />

                            <LinearLayout
                                android:id="@+id/layoutUpcomingReminders"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Payments Preview Sub-card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/sectionUpcomingPayments"
                        style="?attr/materialCardViewFilledStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="14dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/colorDivider"
                        app:cardBackgroundColor="@color/colorSurfaceVariant">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="6dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Payments"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_ms_payments"
                                    app:tint="@color/gl_primary"
                                    android:contentDescription="Payments icon" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtNoUpcomingPayments"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="No upcoming payments"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="13sp"
                                android:visibility="gone"
                                android:paddingVertical="4dp" />

                            <LinearLayout
                                android:id="@+id/layoutUpcomingPayments"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Material 3 Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
